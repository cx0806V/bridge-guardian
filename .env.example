# ============================================================
# 桥体卫士 —— 环境变量配置模板
# 使用方法：复制本文件为 .env，按需修改后保存。
# 注意：.env 已被 .gitignore 忽略，不会提交到仓库。
# ============================================================

# ---- 安全（正式使用/答辩前务必修改）----
# SECRET_KEY：会话签名密钥，建议用随机字符串，例如 `python -c "import secrets;print(secrets.token_hex(32))"`
SECRET_KEY=change-me-to-a-random-string
APP_USERNAME=admin
APP_PASSWORD=123456
# 可选：密码的 SHA-256 十六进制摘要（设置后优先用于校验，避免明文存储）
# 生成方式：python -c "import hashlib;print(hashlib.sha256(b'你的密码').hexdigest())"
# 说明：SHA-256 为校赛演示级别；正式部署建议升级为 PBKDF2/bcrypt 等带盐慢哈希。
# APP_PASSWORD_HASH=
# 可选：是否对 Session Cookie 启用 Secure（仅在 HTTPS 环境设为 1）
SESSION_COOKIE_SECURE=0

# ---- 数据源：sim（模拟）| serial（真实串口）----
DATA_SOURCE=sim

# ---- 串口参数（DATA_SOURCE=serial 时生效）----
# Windows 示例 COM3；Linux/Mac 示例 /dev/ttyUSB0 或 /dev/cu.usbserial-*
SERIAL_PORT=COM3
SERIAL_BAUD=115200

# ---- 采集与报警默认参数 ----
THRESHOLD=120          # 报警阈值（με）
SAMPLE_INTERVAL=1      # 采集周期（秒）

# ---- 存储 ----
DB_PATH=bridge.db      # SQLite 数据库文件路径
