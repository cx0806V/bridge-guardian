<Slide style={{ background: '#FFFFFF', width: '1280px', height: '720px', padding: '0 40px' }}>
  <Box style={{ flexDirection: 'column', width: '100%', height: '100%' }}>
    <Box style={{ height: 88, flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between', borderBottom: '2px solid #1E4FA8' }}>
      <Text style={{ fontSize: 32, fontWeight: 'bold', color: '#0E3F8C' }}>安全与工程化 —— 能交付的程度</Text>
      <Text style={{ fontSize: 14, color: '#8B97A8' }}>桥体卫士</Text>
    </Box>
    <Box style={{ flex: 1, flexDirection: 'row', gap: 24, padding: '18px 0' }}>
      <Box style={{ flex: 1.5, flexDirection: 'column', gap: 14 }}>
        <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#0E3F8C' }}>安全防护</Text>
        {[
          { t: '密钥环境变量化', d: '账号、密码、SECRET_KEY 走 .env，不硬编码进源码' },
          { t: '统一鉴权', d: '所有页面与 API 统一登录保护，未登录 API 返回 401' },
          { t: '写接口保护', d: '清除/改参/确认等写操作受鉴权与校验约束' },
        ].map((item, idx) => (
          <Box key={idx} style={{ flexDirection: 'row', gap: 14, background: '#F7F9FC', border: '1px solid #D6DCE5', borderRadius: 8, padding: '14px 16px', alignItems: 'center' }}>
            <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#1E4FA8', width: 150 }}>{item.t}</Text>
            <Text style={{ fontSize: 17, color: '#4A5568', flex: 1 }}>{item.d}</Text>
          </Box>
        ))}
      </Box>
      <Box style={{ flex: 1, flexDirection: 'column', gap: 14, background: '#E8EFF8', borderRadius: 10, padding: 20 }}>
        <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#0E3F8C' }}>工程化</Text>
        <Box style={{ flexDirection: 'row', alignItems: 'baseline', gap: 8 }}>
          <Text style={{ fontSize: 60, fontWeight: 'bold', color: '#1E4FA8' }}>28</Text>
          <Text style={{ fontSize: 18, color: '#4A5568' }}>项自动化测试全绿</Text>
        </Box>
        <Text style={{ fontSize: 17, color: '#4A5568', lineHeight: 1.6 }}>规则引擎 / 数据层 / 鉴权 / API / 设备心跳 / 串口链路，覆盖核心链路</Text>
        <Box style={{ height: 1, background: '#D6DCE5' }} />
        <Text style={{ fontSize: 17, color: '#4A5568', lineHeight: 1.7 }}>依赖清单 requirements.txt · 配置模板 .env.example · 现场启动手册</Text>
      </Box>
    </Box>
    <Box style={{ height: 40, flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center', borderTop: '1px solid #E5E7EB' }}>
      <Text style={{ fontSize: 14, color: '#8B97A8' }}>桥体卫士 · 桥梁结构健康监测缩尺原型</Text>
      <Text style={{ fontSize: 14, color: '#1E4FA8', fontWeight: 'bold' }}>07 / 14</Text>
    </Box>
  </Box>
</Slide>
