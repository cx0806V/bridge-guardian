<Slide style={{ background: '#FFFFFF', width: '1280px', height: '720px', padding: '0 40px' }}>
  <Box style={{ flexDirection: 'column', width: '100%', height: '100%' }}>
    <Box style={{ height: 88, flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between', borderBottom: '2px solid #1E4FA8' }}>
      <Text style={{ fontSize: 32, fontWeight: 'bold', color: '#0E3F8C' }}>故障注入测试 · 诚实兜底</Text>
      <Text style={{ fontSize: 14, color: '#8B97A8' }}>桥体卫士</Text>
    </Box>
    <Box style={{ flex: 1, flexDirection: 'column', gap: 14, padding: '18px 0' }}>
      <Box style={{ flexDirection: 'row', gap: 12 }}>
        {[
          { t: 'ESP32 拔线/断电', r: '如实离线，触发设备离线报警，不沿用旧值' },
          { t: 'HX711 无响应', r: '固件输出 sensor_state=fault + 错误码，红灯亮' },
          { t: '串口乱码', r: '无效行被丢弃，不影响后续有效数据' },
        ].map((item, idx) => (
          <Box key={idx} style={{ flex: 1, background: '#F7F9FC', border: '1px solid #D6DCE5', borderRadius: 10, padding: 16 }}>
            <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#0E3F8C' }}>{item.t}</Text>
            <Text style={{ fontSize: 15, color: '#4A5568', marginTop: 8, lineHeight: 1.6 }}>{item.r}</Text>
          </Box>
        ))}
      </Box>
      <Box style={{ flexDirection: 'row', gap: 12 }}>
        {[
          { t: '浏览器断开重连', r: 'SQLite 落盘，重连后历史数据完整' },
          { t: '传感器恢复', r: '连续异常计数清零，恢复正常输出' },
          { t: '连续异常读数', r: '错误码由 1 升级为 2（超阈值判故障）' },
        ].map((item, idx) => (
          <Box key={idx} style={{ flex: 1, background: '#F7F9FC', border: '1px solid #D6DCE5', borderRadius: 10, padding: 16 }}>
            <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#0E3F8C' }}>{item.t}</Text>
            <Text style={{ fontSize: 15, color: '#4A5568', marginTop: 8, lineHeight: 1.6 }}>{item.r}</Text>
          </Box>
        ))}
      </Box>
      <Box style={{ background: '#E8EFF8', borderRadius: 10, padding: 16 }}>
        <Text style={{ fontSize: 17, fontWeight: 'bold', color: '#0E3F8C' }}>可复现证据</Text>
        <Text style={{ fontSize: 16, color: '#4A5568', marginTop: 6, lineHeight: 1.6 }}>软件侧故障注入脚本 scripts/fault_injection.py 6/6 通过；真实硬件故障（拔线/拔传感器）现场执行并记录到标定模板。</Text>
      </Box>
    </Box>
    <Box style={{ height: 40, flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center', borderTop: '1px solid #E5E7EB' }}>
      <Text style={{ fontSize: 14, color: '#8B97A8' }}>桥体卫士 · 桥梁结构健康监测缩尺原型</Text>
      <Text style={{ fontSize: 14, color: '#1E4FA8', fontWeight: 'bold' }}>12 / 14</Text>
    </Box>
  </Box>
</Slide>
